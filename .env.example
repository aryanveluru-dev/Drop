# Copy to .env (git-ignored) and fill in. NEVER commit real keys.

# Get a free key at https://build.nvidia.com -> choose a model -> "Get API Key".
# Used only to normalize fetched coupon-page text into structured offers.
NVIDIA_API_KEY=nvapi-your-key-here

